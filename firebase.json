{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|woff2|woff|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/bca/1/BCS-111/**", "destination": "/bca/1/bcs-111/index.html" },
      { "source": "/bca/1/BCS-111", "destination": "/bca/1/bcs-111/index.html" },
      { "source": "/bca/1/BCS-011/**", "destination": "/bca/1/bcs-011/index.html" },
      { "source": "/bca/1/BCS-011", "destination": "/bca/1/bcs-011/index.html" },
      { "source": "/bca/1/BCS-012/**", "destination": "/bca/1/bcs-012/index.html" },
      { "source": "/bca/1/BCS-012", "destination": "/bca/1/bcs-012/index.html" },
      { "source": "/bca/1/BCSL-013/**", "destination": "/bca/1/bcsl-013/index.html" },
      { "source": "/bca/1/BCSL-013", "destination": "/bca/1/bcsl-013/index.html" },
      { "source": "/bca/1/BEGLA-136/**", "destination": "/bca/1/begla-136/index.html" },
      { "source": "/bca/1/BEGLA-136", "destination": "/bca/1/begla-136/index.html" },
      { "source": "/bca/1/BEVAE-181/**", "destination": "/bca/1/bevae-181/index.html" },
      { "source": "/bca/1/BEVAE-181", "destination": "/bca/1/bevae-181/index.html" },
      { "source": "/bca/semester-1/BCS-111/**", "destination": "/bca/1/bcs-111/index.html" },
      { "source": "/bca/semester-1/BCS-111", "destination": "/bca/1/bcs-111/index.html" },
      { "source": "/bca/semester-1/BCS-011/**", "destination": "/bca/1/bcs-011/index.html" },
      { "source": "/bca/semester-1/BCS-011", "destination": "/bca/1/bcs-011/index.html" }
    ]
  }
}
