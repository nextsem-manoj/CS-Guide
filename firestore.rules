rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Contact form submissions: allow creation for anyone, deny read/update/delete for public privacy
    match /contact_submissions/{submission} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // User progress details for the terminal simulator & BCA (public read for peer progress tracking)
    match /users_progress/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // BCA Practical Stories & Community Updates
    match /bca_practical_stories/{storyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Real-Time Cross-Device Cloud Clipboard Sync (Phone ⇄ Laptop)
    match /cross_device_clipboard/{syncId} {
      allow read, write: if true;
    }

    // Student Evaluations & Performance Grading by Lead Faculty
    match /student_evaluations/{evalId} {
      allow read, write: if true;
    }

    // Student In-App Notifications
    match /student_notifications/{notifId} {
      allow read, write: if true;
    }
  }
}
