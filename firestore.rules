rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Contact form submissions: allow creation for anyone, deny read/update/delete for public privacy
    match /contact_submissions/{submission} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // User progress details for the terminal simulator
    match /users_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
  }
}
